#include "kod_04.dtsi"
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&xiao_spi { status = "disabled"; };
&xiao_i2c { status = "disabled"; };
&xiao_serial { status = "disabled"; };

/* uart0 を PS/2 用に使う。
 * 読み時:
 *   RX = D6 (P1.11) へ割り当て
 *   TX = 未使用ピンへ逃がす
 *
 * 書き時:
 *   sleep state にして UART から DATA pin を解放し、
 *   GPIO bit-bang に切り替える
 */
&pinctrl {
    uart0_ps2_default: uart0_ps2_default {
        group1 {
            psels = <
                NRF_PSEL(UART_TX, 0, 30)   /* unused TX */
                NRF_PSEL(UART_RX, 1, 11)   /* D6 = P1.11 = DATA */
            >;
        };
    };

    uart0_ps2_sleep: uart0_ps2_sleep {
        group1 {
            psels = <
                NRF_PSEL(UART_TX, 0, 30)   /* unused TX */
                NRF_PSEL(UART_RX, 0, 31)   /* unused RX */
            >;
            low-power-enable;
        };
    };
};

&uart0 {
    compatible = "nordic,nrf-uarte";
    status = "okay";
    current-speed = <14400>;
    pinctrl-0 = <&uart0_ps2_default>;
    pinctrl-1 = <&uart0_ps2_sleep>;
    pinctrl-names = "default", "sleep";

    uart_ps2: uart_ps2 {
        compatible = "uart-ps2";
        status = "okay";
        scl-gpios = <&xiao_d 7 GPIO_OPEN_DRAIN>; /* CLK = D7 = P1.12 */
        sda-gpios = <&xiao_d 6 GPIO_OPEN_DRAIN>; /* DATA = D6 = P1.11 */
    };
};

/ {
    mouse_ps2: mouse_ps2 {
        compatible = "zmk,input-mouse-ps2";
        status = "okay";
        ps2-device = <&uart_ps2>;

        /* P1.01 を直指定 */
        rst-gpios = <&gpio1 1 GPIO_ACTIVE_LOW>;

        /* 最初は最小構成でよいが、今までの値を使うなら残してよい */
        tp-sensitivity = <100>;
    };

    ps2_listener: ps2_listener {
        compatible = "zmk,input-listener";
        device = <&mouse_ps2>;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
          = <&xiao_d 3  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
          , <&xiao_d 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
          , <&gpio1 7   (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
          , <&xiao_d 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
          , <&xiao_d 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
          ;
        col-gpios
          = <&gpio1 5 GPIO_ACTIVE_HIGH>
          , <&xiao_d 8 GPIO_ACTIVE_HIGH>
          , <&gpio1 3 GPIO_ACTIVE_HIGH>
          , <&xiao_d 5 GPIO_ACTIVE_HIGH>   /* もとの D7 を D5 に移設 */
          , <&xiao_d 2 GPIO_ACTIVE_HIGH>
          , <&xiao_d 1 GPIO_ACTIVE_HIGH>
          , <&xiao_d 0 GPIO_ACTIVE_HIGH>
          ;
    };

    chosen {
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
        col-offset = <7>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6)
            RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
            RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
            RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
            RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
            RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)
        >;
    };
};
&msc_input_listener {
    status = "okay";
};
